<?xml version="1.0" encoding="UTF-8"?>
<!--
    Template of the POM published with each version. The build is Ant (NetBeans):
    "ant release" fills in the version, group and artifact and writes dist/OctopusFile-<version>.pom.
    OctopusFile has no dependencies.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.mizombofrancisco</groupId>
    <artifactId>octopusfile</artifactId>
    <version>2.0.1</version>
    <packaging>jar</packaging>

    <name>OctopusFile</name>
    <description>File toolkit for Java 17+ with no external libraries: transfers, trash, index, batch rename,
        duplicates, disk analysis, backup and sync, encrypted vault, WebDAV/SMB, LAN sharing.</description>
    <url>https://github.com/mizombofrancisco/octopusfile</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Francisco D. C. Mizombo</name>
            <organization>Wonetino Group</organization>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/mizombofrancisco/octopusfile</url>
        <connection>scm:git:https://github.com/mizombofrancisco/octopusfile.git</connection>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>
</project>
